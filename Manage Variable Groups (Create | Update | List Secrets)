function Get-AzDoVariableGroups {
    param(
        [Parameter(Mandatory)][string]$Organization,
        [Parameter(Mandatory)][string]$Project,
        [string]$Pat = $env:AZDO_PAT
    )

    $base64Auth = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes(":$Pat"))
    $headers = @{ Authorization = "Basic $base64Auth" }

    $uri = "https://dev.azure.com/$Organization/$Project/_apis/distributedtask/variablegroups?api-version=7.1"
    $groups = Invoke-RestMethod -Uri $uri -Headers $headers

    $groups.value | Select-Object id, name, type, createdBy, modifiedBy | Format-Table -AutoSize
}

function Update-AzDoVariableGroup {
    param(
        [Parameter(Mandatory)][string]$Organization,
        [Parameter(Mandatory)][string]$Project,
        [Parameter(Mandatory)][int]$VariableGroupId,
        [Parameter(Mandatory)][hashtable]$Variables,   # @{ "MyVar" = @{ value = "secret"; isSecret = $true } }
        [string]$Pat = $env:AZDO_PAT
    )

    $base64Auth = [Convert]::ToBase64String([Text.Encoding]::ASCII.GetBytes(":$Pat"))
    $headers = @{
        Authorization  = "Basic $base64Auth"
        "Content-Type" = "application/json"
    }

    # First get current group
    $getUri = "https://dev.azure.com/$Organization/$Project/_apis/distributedtask/variablegroups/$VariableGroupId`?api-version=7.1"
    $group  = Invoke-RestMethod -Uri $getUri -Headers $headers

    foreach ($key in $Variables.Keys) {
        $group.variables[$key] = $Variables[$key]
    }

    $body = $group | ConvertTo-Json -Depth 10
    $updateUri = "https://dev.azure.com/$Organization/$Project/_apis/distributedtask/variablegroups/$VariableGroupId`?api-version=7.1"
    Invoke-RestMethod -Uri $updateUri -Headers $headers -Method Put -Body $body | Out-Null

    Write-Host "Variable Group $VariableGroupId updated successfully" -ForegroundColor Green
}
