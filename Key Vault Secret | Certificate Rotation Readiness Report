# Lists secrets and certificates approaching expiration with days remaining
$thresholdDays = 30
$report = @()
Get-AzKeyVault | ForEach-Object {
    $vault = $_.VaultName
    Get-AzKeyVaultSecret -VaultName $vault -ErrorAction SilentlyContinue | ForEach-Object {
        if ($_.Expires) {
            $days = ($_.Expires - (Get-Date)).Days
            if ($days -le $thresholdDays) {
                $report += [PSCustomObject]@{
                    Vault     = $vault
                    Type      = "Secret"
                    Name      = $_.Name
                    Expires   = $_.Expires
                    DaysLeft  = $days
                    Enabled   = $_.Enabled
                }
            }
        }
    }
    Get-AzKeyVaultCertificate -VaultName $vault -ErrorAction SilentlyContinue | ForEach-Object {
        if ($_.Expires) {
            $days = ($_.Expires - (Get-Date)).Days
            if ($days -le $thresholdDays) {
                $report += [PSCustomObject]@{
                    Vault     = $vault
                    Type      = "Certificate"
                    Name      = $_.Name
                    Expires   = $_.Expires
                    DaysLeft  = $days
                    Enabled   = $_.Enabled
                }
            }
        }
    }
}
$report | Sort-Object DaysLeft | Format-Table -AutoSize
