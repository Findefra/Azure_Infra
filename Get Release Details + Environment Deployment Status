function Get-AzDoRelease {
    param(
        [Parameter(Mandatory)][string]$Organization,
        [Parameter(Mandatory)][string]$Project,
        [Parameter(Mandatory)][int]$ReleaseId,
        [string]$Pat = $env:AZDO_PAT
    )

    $headers = Get-AzDoHeaders -Pat $Pat
    $uri = "https://vsrm.dev.azure.com/$Organization/$Project/_apis/release/releases/$ReleaseId`?api-version=7.1"

    $release = Invoke-RestMethod -Uri $uri -Headers $headers

    $envStatus = $release.environments | ForEach-Object {
        [PSCustomObject]@{
            Name            = $_.name
            Rank            = $_.rank
            Status          = $_.status
            TriggerReason   = $_.triggerReason
            DeploySteps     = $_.deploySteps.Count
            PreDeployApprovals = ($_.preDeployApprovals.approvals | Where-Object status -eq "pending").Count
            PostDeployApprovals = ($_.postDeployApprovals.approvals | Where-Object status -eq "pending").Count
        }
    }

    [PSCustomObject]@{
        ReleaseId     = $release.id
        Name          = $release.name
        Status        = $release.status
        CreatedBy     = $release.createdBy.displayName
        CreatedOn     = $release.createdOn
        Description   = $release.description
        Url           = $release._links.web.href
        Environments  = $envStatus
    }
}
